<Window x:Class="Cyclop.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Veyron v1" Width="700" Height="444"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded">
 <Canvas x:Name="RootCanvas" ClipToBounds="True">
  <Border x:Name="Panel" Panel.ZIndex="0" Width="192" Height="8" Background="{StaticResource PanelBrush}" BorderThickness="0" RenderTransformOrigin="0.5,0"/>
  <Grid x:Name="PanelContent" Panel.ZIndex="1" Width="620" Height="208" ClipToBounds="True" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ActiveTitle" Grid.Column="0" Text="МУЗЫКА" Margin="16,0,0,0" Foreground="{StaticResource TertiaryBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel x:Name="HeaderStatus" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
     <Grid x:Name="MediaEqualizer" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
      <Rectangle x:Name="MediaBar1" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource TertiaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
      <Rectangle x:Name="MediaBar2" Width="2" Height="7" RadiusX="1" RadiusY="1" Fill="{StaticResource TertiaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
      <Rectangle x:Name="MediaBar3" Width="2" Height="5" RadiusX="1" RadiusY="1" Fill="{StaticResource TertiaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
     </Grid>
     <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TertiaryBrush}" VerticalAlignment="Center" FontSize="10"/>
    </StackPanel>
   </Grid>
    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="LeftRail" Grid.Column="0" Width="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
    <Grid Grid.Column="1" ClipToBounds="True">
     <ContentControl x:Name="PreviousPane" Panel.ZIndex="0" IsHitTestVisible="False" ClipToBounds="True" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed"/>
     <ContentControl x:Name="Pane" Panel.ZIndex="1" ClipToBounds="True" RenderTransformOrigin="0.5,0.5"/>
    </Grid>
    <StackPanel x:Name="RightRail" Grid.Column="2" Width="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
   </Grid>
  </Grid>
 </Canvas>
</Window>
