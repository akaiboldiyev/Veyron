<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Windows Application Packaging\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>{DD4D7B7E-9CF0-44C1-9717-C6DAB9D5CE11}</ProjectGuid>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackage>true</AppxPackage>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxPackageDir>$(ProjectDir)..\..\build\Windows\</AppxPackageDir>
    <PackageCertificateKeyFile Condition="'$(PackageCertificateKeyFile)' == ''">$(ProjectDir)..\Cyclop-dev.pfx</PackageCertificateKeyFile>
    <PackageCertificatePassword Condition="'$(PackageCertificatePassword)' == ''">CyclopLocalBuild</PackageCertificatePassword>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Cyclop.Windows.csproj">
      <Project>{8C2A66D4-7861-4A3D-B218-F9C3200EF065}</Project>
      <Name>Cyclop.Windows</Name>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\Square310x310Logo.png" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Windows Application Packaging\Microsoft.DesktopBridge.targets" />
</Project>
